# ── PostgreSQL (used by docker-compose) ──────────────────────────────────────
POSTGRES_USER=calora_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=calora
# Host ports exposed by docker-compose (container-internal ports stay fixed).
DB_PORT=5435
ADMINER_PORT=8080
API_PORT=3001
WEB_PORT=80

# ── Local-only DATABASE_URL (when running API outside Docker) ────────────────
# In docker-compose, DATABASE_URL is composed from POSTGRES_* above.
DATABASE_URL=postgresql://calora_user:change_me_strong_password@localhost:5435/calora

# ── JWT secrets — generate each with: openssl rand -hex 64 ───────────────────
JWT_SECRET=change_me_generate_with_openssl_rand_hex_64
JWT_REFRESH_SECRET=change_me_generate_another_secret

# ── DeepSeek (OpenAI-compatible) — server-side only ───────────────────────────
# Create a key at https://platform.deepseek.com/api_keys. It is never sent to browsers.
OPENAI_API_KEY=sk-...
# Defaults shown here are the Calora recommended baseline.
OPENAI_MODEL=deepseek-v4-pro
# DeepSeek's OpenAI-compatible endpoint (https://api.deepseek.com also accepts a /v1 suffix).
OPENAI_BASE_URL=https://api.deepseek.com
AI_DAILY_LIMIT=20
AI_CACHE_TTL_HOURS=24
# Cost accounting (USD per 1M tokens) — DeepSeek deepseek-chat pricing defaults.
AI_PRICE_INPUT_PER_M=0.27
AI_PRICE_INPUT_CACHE_HIT_PER_M=0.07
AI_PRICE_OUTPUT_PER_M=1.10

# ── Admin console (optional) ──────────────────────────────────────────────────
# Credentials for the AI cost dashboard at /admin. Stored plaintext in env by design.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong_password

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost
NODE_ENV=production

# ── Email verification (Gmail SMTP) ───────────────────────────────────────────
# Gmail account + App Password (requires 2FA: myaccount.google.com/apppasswords).
# Missing credentials: dev logs verification links to the console; production
# returns 503 on register until configured.
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=Calora <you@gmail.com>
# Optional relay override (e.g. Mailgun/Postmark if Gmail SMTP is throttled from
# a VPS IP). Leave empty for Gmail. 465 implies implicit TLS.
SMTP_HOST=
SMTP_PORT=587

# ── Privacy contact shown in the in-app notice ────────────────────────────────
PRIVACY_CONTACT_EMAIL=privacy@example.com
